# Copy to .env for local use. Change all credentials before any non-local deployment.
MYSQL_DATABASE=contractiq
MYSQL_USER=contractiq
MYSQL_PASSWORD=contractiq-local-only
MYSQL_ROOT_PASSWORD=replace-local-root-password
# Optional host-side ports when 3306 or 6379 are already in use.
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
MINIO_ACCESS_KEY=contractiq
MINIO_SECRET_KEY=replace-local-minio-password
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
KAFKA_MAX_POLL_INTERVAL_MS=900000
KAFKA_MAX_POLL_RECORDS=1
MAX_UPLOAD_BYTES=20971520
TESSERACT_BINARY=tesseract
TESSERACT_LANGUAGES=eng
TESSERACT_TIMEOUT_SECONDS=60
BREVO_EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ContractIQ
